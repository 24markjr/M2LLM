# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Node / frontend ---
node_modules/
frontend/dist/
frontend/.vite/
*.local

# --- Environment ---
.env
.env.*
!.env.example

# --- Agent artifacts ---
# Committed traces are curated demo assets; local scratch traces are not.
.agent/traces/*.local.json
.agent/evals/reports/*.local.json
# Files people upload to missions (Phase 38): theirs, never part of the repository.
.agent/uploads/
# What images, scans, video and audio were understood to contain (Phase 39): derived from them.
.agent/media-cache/
# The Evidence Locker's stored originals (Phase 43): evidence, not source code.
.agent/evidence/
# Run archives (Phase U1): a finished mission kept so it survives a restart.
.agent/runs/

# --- Editors / OS ---
.idea/
.vscode/*
!.vscode/settings.json
.DS_Store
Thumbs.db

# --- Local data ---
pgdata/
ollama-data/
*.log

# --- Teammate source, extracted for porting (ADR-009) ---
# Archived verbatim in .claude/integrations/originals/. The extracted folders carry a
# macOS venv and SQLite files and must never be committed.
jarvis-member3/
mem4/

# A browser session saved by hand for API testing: never committed.
cookies.txt
