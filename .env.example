# JARVIS — environment template.
# Copy to .env and adjust. Never commit .env.

# --- Application ---
APP_ENV=local
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# --- Database ---
# Host-side URL. Inside docker-compose the host is `postgres`, not `localhost`.
DATABASE_URL=postgresql+asyncpg://jarvis:jarvis@localhost:5432/jarvis
POSTGRES_USER=jarvis
POSTGRES_PASSWORD=jarvis
POSTGRES_DB=jarvis
POSTGRES_PORT=5432

# --- LLM provider ---
# ollama | echo   (echo = deterministic fixture provider, no network, used by CI)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
# The vision model (Phase 39); like OLLAMA_MODEL, the environment wins over models.yaml.
VISION_MODEL=qwen2.5vl:3b
# Read (OCR), see (vision model) and hear (Whisper) images, scans, video and audio. Needs
# `pip install -e "backend[media]"`; without it files are accepted and say what to install.
MEDIA_UNDERSTANDING=true
WHISPER_MODEL=base
OLLAMA_TIMEOUT_S=120
LLM_TEMPERATURE=0.0
LLM_SEED=42

# --- Embeddings ---
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768

# --- Agent bounds (invariant #7: every loop has a configured ceiling) ---
MAX_REPLAN_ITERATIONS=3
MAX_TASK_RETRIES=2
MAX_PARALLEL_TASKS=4
MAX_TOOL_CALLS_PER_RUN=40
MAX_PLAN_TASKS=20
RUN_WALLCLOCK_LIMIT_S=600
# Knowledge layer ceilings (Phase 28): model calls per run's extraction, and claims kept.
MAX_KNOWLEDGE_CHUNKS=40
MAX_KNOWLEDGE_CLAIMS=2000

# --- Knowledge graph store (Phase 29, ADR-010) ---
# neo4j (default) or memory. With neo4j unreachable, runs fall back to memory and say so once.
GRAPH_STORE=neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=jarvis-neo4j
NEO4J_DATABASE=neo4j

# --- Tracing ---
# 1 = also write execution traces to .agent/traces/
TRACE_TO_FILE=0

# --- Integrations (Phase 12/15). local = Member 1 fallback implementation. ---
CONTEXT_PROVIDER=local
KNOWLEDGE_PROVIDER=local
# baseline | lexical | composite | remote. composite (the default) by Experiment 004.
VERIFICATION_PROVIDER=composite
# heuristic | naive  (naive is the baseline Experiment 002 measures against)
PLANNING_POLICY=heuristic
M2CONTEXT_BASE_URL=
KNOWLEDGE_BASE_URL=
VERIFICATION_BASE_URL=
INTEGRATION_TIMEOUT_S=30
