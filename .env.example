# JARVIS — environment template.
# Copy to .env and adjust. Never commit .env.

# --- Application ---
APP_ENV=local
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# --- Database ---
# Host-side URL. Inside docker-compose the host is `postgres`, not `localhost`.
DATABASE_URL=postgresql+asyncpg://jarvis:jarvis@localhost:5432/jarvis
POSTGRES_USER=jarvis
POSTGRES_PASSWORD=jarvis
POSTGRES_DB=jarvis
POSTGRES_PORT=5432

# --- LLM provider ---
# ollama | echo   (echo = deterministic fixture provider, no network, used by CI)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT_S=120
LLM_TEMPERATURE=0.0
LLM_SEED=42

# --- Embeddings ---
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768

# --- Agent bounds (invariant #7: every loop has a configured ceiling) ---
MAX_REPLAN_ITERATIONS=3
MAX_TASK_RETRIES=2
MAX_PARALLEL_TASKS=4
MAX_TOOL_CALLS_PER_RUN=40
MAX_PLAN_TASKS=20
RUN_WALLCLOCK_LIMIT_S=600

# --- Tracing ---
# 1 = also write execution traces to .agent/traces/
TRACE_TO_FILE=0

# --- Integrations (Phase 12/15). local = Member 1 fallback implementation. ---
CONTEXT_PROVIDER=local
KNOWLEDGE_PROVIDER=local
VERIFICATION_PROVIDER=baseline
M2CONTEXT_BASE_URL=
KNOWLEDGE_BASE_URL=
VERIFICATION_BASE_URL=
INTEGRATION_TIMEOUT_S=30
